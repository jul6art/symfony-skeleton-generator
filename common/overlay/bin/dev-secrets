#!/usr/bin/env bash
#
# dev-secrets — écrit les secrets de POSTE qui manquent, sans jamais afficher ni remplacer une valeur.
#
#   make secrets                  # dans .env.local
#   bin/dev-secrets .env.docker   # un autre fichier (un projet dont Compose lit .env.docker)
#
# Écrit, s'ils sont absents ou vides du fichier : APP_SECRET, toujours neuf ; MERCURE_JWT_SECRET si
# `.env` le déclare ; chaque variable que le garde-fou des secrets déclare (`core.secrets_guard.variables`)
# ; JWT_PASSPHRASE si LexikJWT est configuré. Pour ces dernières, la valeur que le poste utilise déjà
# (`.env.dev.local`, `.env.dev`, `.env.docker`) est reprise : le hub Mercure, le stockage, la paire de
# clés JWT de la pile locale vont avec elle. Sans valeur de poste, une neuve — et, pour la phrase JWT,
# une paire régénérée. De quoi construire un cache `prod` sur le poste, que le garde-fou refuse avec les
# valeurs du dépôt. Développement seulement : les secrets d'un serveur se posent sur le serveur.
set -euo pipefail
cd "$(dirname "$0")/.."

file="${1:-.env.local}"
console="${CONSOLE:-php bin/console}"
[ -f "$file" ] || : > "$file"
chmod 600 "$file"

written=()
# Une valeur posée et non vide n'est jamais remplacée.
missing() { ! grep -qE "^$1=.+" "$file"; }
put() {
    if grep -qE "^$1=" "$file"; then
        awk -v n="$1" -v v="$2" 'index($0, n"=") == 1 { print n"="v; next } { print }' "$file" > "$file.new"
        mv "$file.new" "$file"
    else
        if [ -s "$file" ] && [ -n "$(tail -c1 "$file")" ]; then echo >> "$file"; fi
        printf '%s=%s\n' "$1" "$2" >> "$file"
    fi
    chmod 600 "$file"
    written+=("$1")
}

# La valeur que le poste utilise déjà pour une variable — le hub Mercure, un stockage, la paire JWT
# de la pile locale vont avec elle : la reprendre, plutôt que d'en tirer une que rien n'attend.
workstation() {
    local source
    for source in .env.dev.local .env.dev .env.docker; do
        if [ "$source" != "$file" ] && grep -qE "^$1=.+" "$source" 2>/dev/null; then
            sed -n "s/^$1=//p" "$source" | tail -1
            return
        fi
    done
}
# fill NOM GÉNÉRATEUR : la valeur du poste s'il en a une, sinon une neuve.
fill() {
    missing "$1" || return 0
    local value
    value=$(workstation "$1")
    if [ -z "$value" ]; then value=$($2); fi
    put "$1" "$value"
}
hex16() { openssl rand -hex 16; }
hex32() { openssl rand -hex 32; }
base64_32() { openssl rand -base64 32; }

# APP_SECRET ne doit correspondre à rien : toujours neuf, et assez long pour le garde-fou.
if missing APP_SECRET; then put APP_SECRET "$(hex16)"; fi
if grep -q '^MERCURE_JWT_SECRET=' .env 2>/dev/null; then fill MERCURE_JWT_SECRET hex32; fi

guarded=$(sed -nE 's/^[[:space:]]+variables:[[:space:]]*\[([^]]*)\].*/\1/p' config/packages/core.yaml 2>/dev/null | tr ',' ' ')
for name in $guarded; do fill "$name" base64_32; done

passphrase=''
if [ -f config/packages/lexik_jwt_authentication.yaml ] && missing JWT_PASSPHRASE; then
    if [ -n "$(workstation JWT_PASSPHRASE)" ]; then
        fill JWT_PASSPHRASE hex32          # celle du poste : la paire de clés va déjà avec elle
    else
        passphrase=$(hex32)
        put JWT_PASSPHRASE "$passphrase"   # aucune : une neuve, et la paire est régénérée plus bas
    fi
fi

if [ ${#written[@]} -eq 0 ]; then
    echo "$file : rien à écrire, chaque secret a déjà sa valeur."
    exit 0
fi
echo "$file : ${written[*]} (valeurs non affichées)"

if [ -n "$passphrase" ]; then
    case "$console" in
        *docker*)
            echo "JWT_PASSPHRASE neuve : recrée le conteneur (docker compose up -d), puis régénère la paire :"
            echo "    $console lexik:jwt:generate-keypair --overwrite" ;;
        *)
            JWT_PASSPHRASE="$passphrase" $console lexik:jwt:generate-keypair --overwrite --no-interaction
            echo "Paire JWT régénérée avec la nouvelle phrase." ;;
    esac
fi
