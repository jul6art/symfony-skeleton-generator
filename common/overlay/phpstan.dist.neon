includes:
    # Une classe de plus de 500 lignes (docbloc compris, hors en-tête du fichier) est refusée : DevTools ≥ 3.8, son
    # ADR-0054. Un projet généré naît sans exception ; une application qui en a hérité les fige dans
    # `phpstan-class-length-baseline.neon`, une liste qui ne peut que diminuer.
    - vendor/jul6art/devtools/resources/phpstan/class-length.neon

parameters:
    level: 8
    # Entités, fixtures, tests et migrations ne sont pas mesurés : une entité porte ses colonnes, des fixtures et des
    # tests leurs données.
    devtoolsClassLength:
        exclude!:
            - '*/Entity/*'
            - '*/DataFixtures/*'
            - '*/tests/*'
            - '*/migrations/*'
    # ⚠️ Un contrôleur n'écrit pas en base : la persistance va dans un service ou un dépôt
    # (`UserRepository::save()` dans le mode backoffice). Un projet généré naît sans exception ; une application
    # qui en a hérité les fige dans une liste qui ne peut que diminuer (`phpstan-controllers-baseline.neon`).
    # Seuls les contrôleurs CRUD d'EasyAdmin (`*CrudController.php`, sa convention) y échappent : `persistEntity()` et
    # ses sœurs reçoivent l'entity manager par LEUR signature. Par chemin et non par héritage : `allowInInstanceOf`
    # n'en couvrait rien, ni l'import ni les paramètres (essayé sur le mode admin généré, 2026-11-14).
    filesRootDir: %rootDir%/../../..
    disallowedClasses:
        -
            class: 'Doctrine\ORM\EntityManagerInterface'
            message: "un contrôleur n'écrit pas en base : la persistance va dans un service ou un dépôt"
            allowExceptIn:
                - src/*Controller.php
            allowIn:
                - src/*CrudController.php
    paths:
        - src
        - tests
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    doctrine:
        # Les entités portent des propriétés nullables tant qu'elles ne sont pas
        # persistées (style maker), alors que la colonne est NOT NULL.
        allowNullablePropertyForRequiredField: true
