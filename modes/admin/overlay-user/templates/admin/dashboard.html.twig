{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Tableau de bord{% endblock %}

{% block main %}
    <div class="row">
        <div class="col-md-6">
            <div class="content-panel p-4">
                <h2 class="h5 mb-3">
                    <i class="fa fa-users text-primary me-2"></i> Comptes
                </h2>
                <p class="text-muted mb-3">
                    {{ user_count }} compte{{ user_count > 1 ? 's' : '' }} enregistré{{ user_count > 1 ? 's' : '' }}.
                </p>
                <a class="btn btn-primary" href="{{ ea_url().setController('App\\Controller\\Admin\\UserCrudController').setAction('index') }}">
                    Gérer les comptes
                </a>
            </div>
        </div>
        <div class="col-md-6">
            <div class="content-panel p-4">
                <h2 class="h5 mb-3">
                    <i class="fa fa-arrow-left text-primary me-2"></i> Le site
                </h2>
                <p class="text-muted mb-3">
                    Le back-office et le site partagent les mêmes comptes et la même palette.
                </p>
                <a class="btn btn-outline-secondary" href="{{ path('app_home') }}">Retour au site</a>
            </div>
        </div>
    </div>
{% endblock %}
