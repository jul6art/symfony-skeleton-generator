{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}{{ 'admin.dashboard'|trans }}{% endblock %}

{% block main %}
    <div class="row g-4">
        <div class="col-md-6">
            <div class="app-card">
                <h2 class="app-card-title">
                    <i class="fa fa-users"></i> {{ 'admin.cards.accounts.title'|trans }}
                </h2>
                <p class="app-card-body">{{ 'admin.cards.accounts.count'|trans({'%count%': user_count}) }}</p>
                <a class="btn btn-primary" href="{{ ea_url().setController('App\\Controller\\Admin\\UserCrudController').setAction('index') }}">
                    {{ 'admin.cards.accounts.manage'|trans }}
                </a>
            </div>
        </div>
        <div class="col-md-6">
            <div class="app-card">
                <h2 class="app-card-title">
                    <i class="fa fa-arrow-left"></i> {{ 'admin.cards.site.title'|trans }}
                </h2>
                <p class="app-card-body">{{ 'admin.cards.site.body'|trans }}</p>
                <a class="btn btn-outline-secondary" href="{{ path('app_home') }}">{{ 'admin.back_to_site'|trans }}</a>
            </div>
        </div>
    </div>
{% endblock %}
