{#
    Modale de confirmation, à placer dans un formulaire qui porte
    data-controller="confirm" data-action="submit->confirm#request".

    Paramètres : dialog_id, title, message, highlight (optionnel, mis en avant
    devant le message), icon, confirm_label, confirm_icon, cancel_label.
#}
<dialog data-confirm-target="dialog"
        aria-labelledby="{{ dialog_id }}"
        class="m-auto w-[min(28rem,calc(100vw-2rem))] rounded-xl border border-slate-200 bg-white p-0 text-slate-800 shadow-xl backdrop:bg-slate-900/50">
    <div class="p-6">
        <div class="flex items-start gap-3">
            <span class="flex size-10 shrink-0 items-center justify-center rounded-full {{ icon_class|default('bg-red-100 text-red-600') }}">
                <i class="fa-solid {{ icon|default('fa-triangle-exclamation') }}"></i>
            </span>
            <div>
                <h2 id="{{ dialog_id }}" class="text-lg font-semibold text-slate-900">{{ title }}</h2>
                <p class="mt-1 text-sm text-slate-600">
                    {%- if highlight is defined and highlight %}<span class="font-medium text-slate-900">{{ highlight }}</span> {% endif -%}
                    {{ message }}
                </p>
            </div>
        </div>

        <div class="mt-6 flex justify-end gap-2">
            <button type="button" class="btn btn-secondary" data-action="confirm#cancel">
                {{ cancel_label|default('action.cancel'|trans) }}
            </button>
            <button type="button" class="btn {{ confirm_class|default('btn-danger') }}" data-action="confirm#accept">
                <i class="fa-solid {{ confirm_icon|default('fa-check') }}"></i> {{ confirm_label|default('action.confirm'|trans) }}
            </button>
        </div>
    </div>
</dialog>
