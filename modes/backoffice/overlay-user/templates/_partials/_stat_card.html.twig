{# Un compteur. Attend `icon`, `label`, `value`. #}
<div class="panel p-5 flex items-center gap-4">
    <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-accent-50 dark:bg-accent-900/30 text-accent-600 dark:text-accent-400">
        <i class="{{ icon }} text-lg"></i>
    </span>
    <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 dark:text-slate-500">{{ label }}</p>
        <p class="text-2xl font-bold text-slate-900 dark:text-slate-100">{{ value }}</p>
    </div>
</div>
