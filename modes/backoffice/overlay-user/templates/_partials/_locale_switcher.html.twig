{#
    Le sélecteur de langue de la barre du haut.

    ⚠️ PAS de `<form>` : chaque bouton POSTe par `fetch()` au travers du contrôleur Stimulus
    `ui--locale-switcher` d'`admin-bundle`. Un second `<form>` sur chaque page ferait matcher
    `$crawler->filter('form')->form()` sur le sélecteur au lieu du formulaire de la page, et
    casserait la moitié des tests fonctionnels sans que le rapport ne dise pourquoi.

    Il ne dépend PAS d'un compte connecté : on choisit sa langue avant d'en avoir un.
#}
<div class="relative"
     data-ui-dropdown
     data-controller="ui--locale-switcher"
     data-ui--locale-switcher-url-value="{{ path('admin_locale_switch') }}"
     data-ui--locale-switcher-token-value="{{ csrf_token('locale_switch') }}">
    <button type="button"
            class="flex items-center gap-2 rounded-xl px-2 py-1.5 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors text-sm text-slate-700 dark:text-slate-200"
            aria-label="{{ 'user.locale.switcher_label'|trans({}, 'user') }}"
            data-ui-dropdown-toggle>
        <span class="uppercase text-xs font-semibold">{{ app.request.locale }}</span>
        <i class="fa-solid fa-chevron-down text-xs text-slate-500 dark:text-slate-400"></i>
    </button>
    <div data-ui-dropdown-menu class="hidden absolute right-0 mt-2 w-48 rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1.5 shadow-xl z-10">
        {% for code in backoffice_locales() %}
            <button type="button"
                    data-locale="{{ code }}"
                    data-action="click->ui--locale-switcher#switch"
                    class="flex items-center gap-3 w-full px-3 py-2 rounded-lg text-sm {% if app.request.locale == code %}bg-slate-100 dark:bg-slate-700 text-slate-900 dark:text-slate-100 font-semibold{% else %}text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700{% endif %}">
                <span class="flex-1 text-left">{{ ('user.locale.' ~ code)|trans({}, 'user') }}</span>
                <span class="uppercase text-[10px] text-slate-400 font-mono">{{ code }}</span>
            </button>
        {% endfor %}
    </div>
</div>
