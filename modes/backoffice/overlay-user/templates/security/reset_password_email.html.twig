{#
    Le mail de réinitialisation, sur le layout brandé d'`admin-bundle` : logo, nom, panneau,
    bouton — tout inline, un client mail ne charge aucune feuille de style.

    ⚠️ `url()` et non `path()` : un lien de mail est cliqué hors du site, un chemin relatif n'y
    mène nulle part. Hors requête (mail envoyé par une commande), le host vient de `DEFAULT_URI`.
#}
{% extends '@Admin/email/base.html.twig' %}
{% trans_default_domain 'security' %}

{% block email_title %}{{ 'security.reset_password.email.subject'|trans }}{% endblock %}

{% block email_body %}
    <p style="margin: 0 0 16px;">{{ 'security.reset_password.email.intro'|trans }}</p>

    {{ include('@Admin/email/_button.html.twig', {
        url: url('admin_reset_password_reset', { token: resetToken.token }),
        label: 'security.reset_password.email.cta'|trans,
    }) }}

    {# La durée vient du jeton lui-même : l'écrire en dur ici la ferait mentir dès qu'on change la
       configuration du bundle. #}
    <p style="margin: 16px 0 0; font-size: 13px; color: #64748b;">
        {{ 'security.reset_password.email.expires'|trans({'%duration%': resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle')}) }}
    </p>
{% endblock %}
