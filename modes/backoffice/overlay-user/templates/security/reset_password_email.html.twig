{% trans_default_domain 'security' %}
<p>{{ 'security.reset_password.email.intro'|trans }}</p>

<p>
    <a href="{{ url('admin_reset_password_reset', {token: resetToken.token}) }}">
        {{ 'security.reset_password.email.cta'|trans }}
    </a>
</p>

{# La durée vient du jeton lui-même : l'écrire en dur ici la ferait mentir dès qu'on change la
   configuration du bundle. #}
<p>{{ 'security.reset_password.email.expires'|trans({'%duration%': resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle')}) }}</p>
