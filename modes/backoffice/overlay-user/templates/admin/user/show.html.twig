{#
    La fiche d'un compte, sur le gabarit de fiche d'admin-bundle (`@Admin/record/_page.html.twig`,
    1.35) : l'en-tête (photo, nom, état, adresse), une bande de chiffres, puis les informations.

    ⚠️ Le lien « Éditer » distingue SA PROPRE fiche : sur soi il mène au profil (que tout compte
    peut ouvrir), sur quelqu'un d'autre à l'écran d'administration (gardé par `user:update`).
    Envoyer tout le monde sur `admin_user_edit` offrait un lien qui répond 403 à la moitié des
    comptes — un bug d'interface, pas de sécurité, et que seul l'écran montre.

    ⚠️ Les actions restent des boutons, sans menu ⋯ : « Désactiver » est une transition (orange,
    comme sa ligne de table et sa modale — item D8), « Modifier » une lecture (sobre).

    ⚠️ `ROLE_USER` n'est pas affiché : il vient de la hiérarchie, personne ne peut le retirer, et
    le montrer dans une liste de rôles laisse croire le contraire.
#}
{% extends 'admin/layout.html.twig' %}
{% trans_default_domain 'user' %}

{% block title %}{{ user.displayName }} · {{ admin_branding().name }}{% endblock %}

{% block content %}
    <div class="max-w-4xl">
        {% embed '@Admin/record/_page.html.twig' %}
            {% trans_default_domain 'user' %}
            {% import '@Admin/record/_macros.html.twig' as record %}

            {% block record_breadcrumb %}
                <nav class="text-xs text-slate-400 dark:text-slate-500">
                    <a href="{{ path('admin_user_index') }}" class="hover:text-slate-700 dark:hover:text-slate-300">{{ 'user.list.title'|trans }}</a>
                    <span class="mx-2">/</span><span class="text-slate-600 dark:text-slate-400">{{ user.displayName }}</span>
                </nav>
            {% endblock %}

            {% block record_avatar %}
                {% set photo = admin_user_avatar(user) %}
                {{ record.avatar(user.displayName, { round: true, image: photo ? asset(photo) : null }) }}
            {% endblock %}

            {% block record_title %}{{ user.displayName }}{% endblock %}

            {% block record_badges %}
                <span class="{{ user.isActive ? 'badge-active' : 'badge-inactive' }}">
                    {{ (user.isActive ? 'datatable.status.active' : 'datatable.status.inactive')|trans({}, 'javascript') }}
                </span>
            {% endblock %}

            {% block record_meta %}<span>{{ user.email }}</span>{% endblock %}

            {% block record_actions %}
                {% if user.id == app.user.id %}
                    <a href="{{ path('admin_account_profile_edit') }}" class="btn-secondary">
                        <i class="fa-solid fa-pen-to-square"></i> {{ 'action.edit'|trans({}, 'messages') }}
                    </a>
                {% elseif is_granted(constant('App\\Security\\PermissionCodes::USER_UPDATE')) and is_granted('USER_ACCOUNT_MANAGE', user) %}
                    <a href="{{ path('admin_user_edit', {id: user.id}) }}" class="btn-secondary">
                        <i class="fa-solid fa-pen-to-square"></i> {{ 'action.edit'|trans({}, 'messages') }}
                    </a>
                {% endif %}

                {# Activer / désactiver : sous l'attribut qui les gouverne, jamais sur soi, ni sur un super-admin pour qui n'en est pas un. #}
                {% if is_granted(constant('App\\Security\\PermissionCodes::USER_ACTIVATE')) and user.id != app.user.id and is_granted('USER_ACCOUNT_MANAGE', user) %}
                    {% set toggleRoute = user.isActive ? 'admin_user_deactivate' : 'admin_user_activate' %}
                    {% set toggleLabel = user.isActive ? 'action.deactivate' : 'action.activate' %}
                    <form method="post" action="{{ path(toggleRoute, {id: user.id}) }}"
                          data-controller="ui--modal"
                          data-action="submit->ui--modal#intercept"
                          data-ui--modal-title-value="{{ toggleLabel|trans({}, 'messages') }}"
                          data-ui--modal-message-value="{{ 'user.confirm.toggle'|trans }}"
                          data-ui--modal-confirm-label-value="{{ toggleLabel|trans({}, 'messages') }}"
                          data-ui--modal-cancel-label-value="{{ 'action.cancel'|trans({}, 'messages') }}"
                          data-ui--modal-confirm-variant-value="{{ user.isActive ? 'warning' : 'primary' }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('datatable_action') }}">
                        {# ⚠️ La variante du BOUTON suit celle de la modale qu'il ouvre (juste au-dessus,
                           `confirm-variant`) et celle de la même action dans le menu d'une ligne de la
                           table. Un « Désactiver » gris qui ouvre une modale orange se lit comme deux
                           actions différentes — c'est le défaut que l'item D8 de la checklist ferme. #}
                        <button type="submit" class="{{ user.isActive ? 'btn-warning' : 'btn-success' }}">
                            <i class="fa-solid {{ user.isActive ? 'fa-ban' : 'fa-circle-check' }}"></i>
                            {{ toggleLabel|trans({}, 'messages') }}
                        </button>
                    </form>
                {% endif %}
            {% endblock %}

            {% block record_stats %}
                <div class="admin-record__stats">
                    {{ record.stat('user.show.member_since'|trans, user.createdAt|date('d/m/Y')) }}
                    {{ record.stat('user.show.two_factor'|trans,
                        (user.totpAuthenticationEnabled ? 'user.show.two_factor_on' : 'user.show.two_factor_off')|trans,
                        {
                            tone: user.totpAuthenticationEnabled ? 'success' : null,
                            hint: user.totpAuthenticationEnabled ? 'user.show.backup_codes'|trans({'%count%': user.countBackupCodes}) : null,
                        }|filter(value => value is not null)) }}
                </div>
            {% endblock %}

            {% block record_main %}
                {# Les informations restent dans l'aperçu d'une liste (`data-preview-keep`, datatable-bundle 2.13). #}
                <div class="panel p-6" data-preview-keep>
                    <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-700 dark:text-slate-300 mb-4">{{ 'user.show.info_title'|trans }}</h2>
                    {% set roleBadges %}
                        {% for role in user.roles|filter(role => role in roleLabels|keys) %}
                            <span class="badge-violet">{{ roleLabels[role]|trans }}</span>
                        {% endfor %}
                    {% endset %}
                    {{ record.properties([
                        { icon: 'fa-envelope', label: 'user.field.email'|trans, value: user.email },
                        { icon: 'fa-user-shield', label: 'user.field.roles'|trans, value: roleBadges|trim is empty ? null : roleBadges },
                        { icon: 'fa-language', label: 'user.show.language'|trans, value: ('user.locale.' ~ user.locale)|trans },
                        { icon: 'fa-calendar', label: 'user.field.created_at'|trans, value: user.createdAt|date('d/m/Y H:i') },
                    ]) }}
                </div>
            {% endblock %}
        {% endembed %}
    </div>
{% endblock %}
