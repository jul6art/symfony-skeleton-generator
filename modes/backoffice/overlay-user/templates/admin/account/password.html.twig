{#
    Changer son propre mot de passe.

    ⚠️ La largeur se pose DANS le contenu (cf. `profile.html.twig`) : `container_class` porte
    `mx-auto` dans le layout du bundle, donc le restreindre recentrerait toute la page.
#}
{% extends 'admin/layout.html.twig' %}
{% trans_default_domain 'security' %}

{% block title %}{{ 'security.change_password.title'|trans }} · {{ admin_branding().name }}{% endblock %}

{% block content %}
    <div class="max-w-2xl">
        <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-6">{{ 'security.change_password.title'|trans }}</h1>

        <div class="form-panel">
            {{ form_start(form, { attr: { class: 'form-grid' } }) }}
                {{ form_errors(form) }}
                {{ form_widget(form) }}
                <div class="form-actions">
                    <button type="submit" class="btn-primary">{{ 'action.save'|trans({}, 'messages') }}</button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
