{% extends 'admin/layout.html.twig' %}
{% trans_default_domain 'messages' %}

{% block title %}{{ 'nav.dashboard'|trans }} · {{ admin_branding().name }}{% endblock %}

{% block content %}
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100">{{ 'dashboard.title'|trans }}</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">{{ 'dashboard.subtitle'|trans }}</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {{ include('_partials/_stat_card.html.twig', {
            icon: 'fa-solid fa-users', label: 'dashboard.total_users'|trans, value: total_users,
        }) }}
        {{ include('_partials/_stat_card.html.twig', {
            icon: 'fa-solid fa-user-check', label: 'dashboard.active_users'|trans, value: active_users,
        }) }}
    </div>
{% endblock %}
