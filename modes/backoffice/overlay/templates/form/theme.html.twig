{#
    Le thème de formulaire du projet.

    Il vient APRÈS celui d'`ui-bundle` dans `twig.form_themes` : Symfony retient la dernière
    définition d'un bloc, donc tout ce qui est redéclaré ici gagne. L'ordre inverse rendrait ce
    fichier inerte, sans erreur.

    Les classes viennent d'`admin-bundle` (`.form-control`, `.form-label`, `.form-error`…) : les
    redéfinir ici ferait diverger les formulaires du reste de la coquille.
#}
{% use 'form_div_layout.html.twig' %}

{% block form_row %}
    <div class="form-field">
        {{ form_label(form) }}
        {{ form_widget(form) }}
        {{ form_help(form) }}
        {{ form_errors(form) }}
    </div>
{% endblock %}

{% block form_label %}
    {% if label is not same as(false) %}
        {% set label_attr = label_attr|merge({ class: (label_attr.class|default('') ~ ' form-label')|trim }) %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block form_widget_simple %}
    {% set attr = attr|merge({ class: (attr.class|default('') ~ ' form-control')|trim }) %}
    {{ parent() }}
{% endblock %}

{% block textarea_widget %}
    {% set attr = attr|merge({ class: (attr.class|default('') ~ ' form-control')|trim }) %}
    {{ parent() }}
{% endblock %}

{% block choice_widget_collapsed %}
    {% set attr = attr|merge({ class: (attr.class|default('') ~ ' form-control')|trim }) %}
    {{ parent() }}
{% endblock %}

{#
    Le widget NU : ni label ni conteneur. C'est `checkbox_row` (plus bas) qui pose l'interrupteur
    et son libellé. Les deux ensemble écriraient le libellé deux fois.
#}
{% block checkbox_widget %}
    <input type="checkbox" {{ block('widget_attributes') }}{% if value is defined %} value="{{ value }}"{% endif %}{% if checked %} checked="checked"{% endif %}>
{% endblock %}

{% block form_errors %}
    {% if errors|length > 0 %}
        <ul class="mt-1 space-y-0.5">
            {% for error in errors %}
                <li class="form-error">{{ error.message }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}

{% block form_help %}
    {% if help is not empty %}
        <p class="form-help">{{ help|trans({}, translation_domain) }}</p>
    {% endif %}
{% endblock %}

{#
    Une case à cocher se rend en interrupteur, pas en carré système : c'est ce que le reste de la
    coquille montre (les jetons `.toggle-*` viennent d'`admin-bundle`). Sans ce bloc, les réglages
    d'accessibilité de la page Apparence — contraste élevé, animations réduites — sortaient en
    cases natives au milieu d'un formulaire stylé.
#}
{% block checkbox_row %}
    {% set labelText = label is not empty
        ? label|trans({}, translation_domain)
        : name|humanize %}

    <div class="form-field form-field-checkbox">
        <label class="toggle-row" for="{{ id }}">
            <span class="toggle-switch">
                {{ form_widget(form, { attr: { class: 'toggle-switch-input' } }) }}
                <span class="toggle-switch-track"></span>
            </span>
            <span class="toggle-label">
                {{ labelText }}
                {% if required %}<span class="text-red-500">*</span>{% endif %}
            </span>
        </label>
        {{ form_help(form) }}
        {{ form_errors(form) }}
    </div>
{% endblock %}
