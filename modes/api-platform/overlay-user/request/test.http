# Requêtes de test de l'API — client HTTP de PhpStorm / VS Code (REST Client).
#
# Sélectionner l'environnement « dev » (http-client.env.json) avant de jouer les
# requêtes. Le mot de passe vit dans http-client.private.env.json, non versionné.
#
# Ordre d'exécution : « Connexion » d'abord, elle enregistre le jeton dans une
# variable globale utilisée par toutes les requêtes protégées.

### Sonde de santé (publique, sans base de données)
GET {{host}}/health
Accept: application/json

> {%
    client.test("la sonde répond", () => client.assert(response.status === 200));
%}

### Documentation OpenAPI (JSON)
GET {{host}}/api/docs.jsonopenapi
Accept: application/vnd.openapi+json

### Connexion — enregistre le jeton pour les requêtes suivantes
# @name login
POST {{host}}/api/login
Content-Type: application/json
Accept: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
    client.test("jeton reçu", () => {
        client.assert(response.status === 200, "statut " + response.status);
        client.assert(response.body.token !== undefined, "pas de jeton dans la réponse");
    });
    client.global.set("token", response.body.token);
%}

### Compte porté par le jeton
GET {{host}}/api/me
Authorization: Bearer {{token}}
Accept: application/ld+json

> {%
    client.test("le mot de passe ne sort jamais", () => {
        client.assert(response.body.password === undefined);
    });
%}

### Liste des comptes (USER_LIST, réservé à l'administration) — retient le premier identifiant
# @name users
GET {{host}}/api/users
Authorization: Bearer {{token}}
Accept: application/ld+json

> {%
    client.test("collection paginée", () => {
        client.assert(response.status === 200, "statut " + response.status);
        client.assert(response.body.totalItems !== undefined);
    });
    if (response.body.member && response.body.member.length > 0) {
        client.global.set("userId", response.body.member[0].id);
    }
%}

### Liste des comptes, deuxième page
GET {{host}}/api/users?page=2&itemsPerPage=10
Authorization: Bearer {{token}}
Accept: application/ld+json

### Fiche d'un compte (soi-même, ou n'importe lequel pour un administrateur)
GET {{host}}/api/users/{{userId}}
Authorization: Bearer {{token}}
Accept: application/ld+json

### Sans jeton : doit répondre 401
GET {{host}}/api/users
Accept: application/ld+json

> {%
    client.test("l'API est fermée sans jeton", () => client.assert(response.status === 401));
%}

### Jeton invalide : doit répondre 401
GET {{host}}/api/me
Authorization: Bearer jeton-bidon
Accept: application/ld+json

> {%
    client.test("un jeton invalide est refusé", () => client.assert(response.status === 401));
%}

### Mauvais mot de passe : doit répondre 401
POST {{host}}/api/login
Content-Type: application/json
Accept: application/json

{
  "email": "{{email}}",
  "password": "mauvais-mot-de-passe"
}

> {%
    client.test("identifiants invalides refusés", () => client.assert(response.status === 401));
%}

### Préflight CORS (l'origine doit correspondre à CORS_ALLOW_ORIGIN)
OPTIONS {{host}}/api/me
Origin: http://localhost:3000
Access-Control-Request-Method: GET
Access-Control-Request-Headers: authorization
