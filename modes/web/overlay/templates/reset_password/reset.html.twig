{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe — {{PROJECT_TITLE}}{% endblock %}

{% block body %}
    <div class="mx-auto max-w-md">
        <div class="card">
            <h1 class="mb-6 flex items-center gap-2 text-xl font-semibold text-slate-900">
                <i class="fa-solid fa-lock-open text-indigo-600"></i> Nouveau mot de passe
            </h1>

            {{ form_start(resetForm) }}
                {{ form_row(resetForm.plainPassword.first) }}
                {{ form_row(resetForm.plainPassword.second) }}
                {{ form_errors(resetForm.plainPassword) }}

                <button type="submit" class="btn btn-primary w-full">
                    <i class="fa-solid fa-check"></i> Enregistrer
                </button>
            {{ form_end(resetForm) }}
        </div>
    </div>
{% endblock %}
