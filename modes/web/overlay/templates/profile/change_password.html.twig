{% extends 'base.html.twig' %}

{% block title %}Changer de mot de passe — {{PROJECT_TITLE}}{% endblock %}

{% block body %}
    <div class="mx-auto max-w-md">
        <div class="card">
            <h1 class="mb-6 flex items-center gap-2 text-xl font-semibold text-slate-900">
                <i class="fa-solid fa-key text-indigo-600"></i> Changer de mot de passe
            </h1>

            {{ form_start(changePasswordForm) }}
                {{ form_row(changePasswordForm.currentPassword) }}
                {{ form_row(changePasswordForm.plainPassword.first) }}
                {{ form_row(changePasswordForm.plainPassword.second) }}
                {{ form_errors(changePasswordForm.plainPassword) }}

                <div class="flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-check"></i> Enregistrer
                    </button>
                    <a href="{{ path('app_profile') }}" class="btn btn-secondary">Annuler</a>
                </div>
            {{ form_end(changePasswordForm) }}
        </div>
    </div>
{% endblock %}
