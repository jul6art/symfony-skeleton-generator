{% extends 'base.html.twig' %}

{% block title %}{{ 'reset.new.title'|trans }} — {{PROJECT_TITLE}}{% endblock %}

{% block body %}
    <div class="mx-auto max-w-md">
        <div class="card">
            <h1 class="mb-6 flex items-center gap-2 text-xl font-semibold text-slate-900">
                <i class="fa-solid fa-lock-open text-indigo-600"></i> {{ 'reset.new.title'|trans }}
            </h1>

            {{ form_start(form) }}
                {{ form_row(form.plainPassword.first) }}
                {{ form_row(form.plainPassword.second) }}
                {{ form_errors(form.plainPassword) }}

                <button type="submit" class="btn btn-primary w-full">
                    <i class="fa-solid fa-check"></i> {{ 'action.save'|trans }}
                </button>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
