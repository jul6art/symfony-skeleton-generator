{% extends 'base.html.twig' %}

{% block title %}{{ 'reset.check_email.title'|trans }} — {{PROJECT_TITLE}}{% endblock %}

{% block body %}
    <div class="mx-auto max-w-md">
        <div class="card text-center">
            <i class="fa-solid fa-envelope-circle-check mb-4 text-4xl text-indigo-600"></i>
            <h1 class="mb-2 text-xl font-semibold text-slate-900">{{ 'reset.check_email.title'|trans }}</h1>
            <p class="text-sm text-slate-600">{{ 'reset.check_email.body'|trans({'%duration%': resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle')}) }}</p>
            <p class="mt-4 text-sm text-slate-500">
                {{ 'reset.check_email.spam'|trans({'%link%': '<a href="' ~ path('app_forgot_password_request') ~ '" class="text-indigo-600 hover:underline">' ~ 'reset.check_email.again'|trans ~ '</a>'})|raw }}
            </p>
        </div>
    </div>
{% endblock %}
