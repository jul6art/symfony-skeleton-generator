{% extends 'base.html.twig' %}

{% block title %}{{ user.email }} — {{PROJECT_TITLE}}{% endblock %}

{% block body %}
    <div class="mx-auto max-w-2xl">
        <h1 class="mb-6 flex items-center gap-2 text-2xl font-semibold text-slate-900">
            <i class="fa-solid fa-user text-indigo-600"></i> {{ user.email }}
        </h1>

        <div class="card">
            <dl class="divide-y divide-slate-100">
                <div class="flex justify-between py-3 text-sm">
                    <dt class="text-slate-500">{{ 'admin.users.id'|trans }}</dt>
                    <dd class="font-medium text-slate-900">#{{ user.id }}</dd>
                </div>
                <div class="flex justify-between py-3 text-sm">
                    <dt class="text-slate-500">{{ 'user.roles'|trans }}</dt>
                    <dd class="font-medium text-slate-900">{{ user.roles|join(', ') }}</dd>
                </div>
            </dl>

            <div class="mt-6 flex flex-wrap gap-2">
                <a href="{{ path('app_admin_user_edit', {id: user.id}) }}" class="btn btn-primary">
                    <i class="fa-solid fa-pen"></i> {{ 'admin.users.edit'|trans }}
                </a>
                <a href="{{ path('app_admin_user_index') }}" class="btn btn-secondary">{{ 'admin.users.back'|trans }}</a>
                {{ include('admin/user/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
{% endblock %}
